{
  "name": "rxpos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pharmacy POS — multi-tenant counter, batches, expiry and controlled-drug compliance",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "check": "node --disable-warning=ExperimentalWarning --check src/tenant.ts",
    "build": "esbuild src/client/app.ts --bundle --format=esm --outfile=public/app.js --target=es2022 --log-level=warning",
    "demo": "npm run build && node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "start": "node --disable-warning=ExperimentalWarning scripts/serve.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
